# Copy to .env and fill in. Only needed to collect NEW model responses or rebuild the
# YouTube dataset; every analysis in this repo runs from the experiments' data/ folders without any keys.

# OpenAI (GPT-4o in Exp 1 & 3; o1 / o3-mini in Exp 2; censoring in Exp 3)
OPENAI_API_KEY=

# Azure OpenAI (GPT-4o in Exp 2 was run through Azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini 2.0 Flash, via the OpenAI-compatible endpoint)
GEMINI_API_KEY=

# Together AI (Llama 3.x, Gemma 3, DeepSeek-R1; Llama 3.2 Vision / Qwen2-VL in Exp 1)
TOGETHER_API_KEY=

# YouTube Data API v3 (only for rebuilding the Exp 3 video dataset)
YOUTUBE_API_KEY=
